{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_MIGRATION_DATABASE_URL"],
      "cache": false
    }
  }
}
