# Copier en .env — ne jamais committer de vraies valeurs.
NODE_ENV=development
APP_URL=http://localhost:3000

# Rôle applicatif, soumis au RLS.
DATABASE_URL=postgres://paiecam_app:app_dev@localhost:5432/paiecam
# Rôle propriétaire, utilisé uniquement pour appliquer les migrations.
MIGRATION_DATABASE_URL=postgres://paiecam_owner:owner_dev@localhost:5432/paiecam

# Base dédiée aux tests d'intégration (vidée à chaque lancement).
TEST_DATABASE_URL=postgres://paiecam_app:app_dev@localhost:5432/paiecam_test
TEST_MIGRATION_DATABASE_URL=postgres://paiecam_owner:owner_dev@localhost:5432/paiecam_test
TEST_OPS_DATABASE_URL=postgres://paiecam_ops:ops_dev@localhost:5432/paiecam_test

# Secret de Better Auth (au moins 32 caractères) : openssl rand -base64 32
BETTER_AUTH_SECRET=

# Vérification des mots de passe fuités (Have I Been Pwned). « off » interdit en production.
PWNED_PASSWORDS_CHECK=on

# Clé de chiffrement des champs sensibles (32 octets en base64). En prod : fournie par le KMS.
FIELD_ENCRYPTION_KEY=
