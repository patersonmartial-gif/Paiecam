# Copier en .env — ne jamais committer de vraies valeurs.
NODE_ENV=development
APP_URL=http://localhost:3000

# Rôle applicatif, soumis au RLS.
DATABASE_URL=postgres://paiecam_app:app_dev@localhost:5432/paiecam
# Rôle propriétaire, utilisé uniquement pour appliquer les migrations.
MIGRATION_DATABASE_URL=postgres://paiecam_owner:owner_dev@localhost:5432/paiecam

# Base dédiée aux tests d'intégration (vidée à chaque lancement).
TEST_DATABASE_URL=postgres://paiecam_app:app_dev@localhost:5432/paiecam_test
TEST_MIGRATION_DATABASE_URL=postgres://paiecam_owner:owner_dev@localhost:5432/paiecam_test
TEST_OPS_DATABASE_URL=postgres://paiecam_ops:ops_dev@localhost:5432/paiecam_test
TEST_BACKUP_DATABASE_URL=postgres://paiecam_backup:backup_dev@localhost:5432/paiecam_test
# Administrateur local (test de restauration uniquement ; Docker : mot de passe POSTGRES_PASSWORD)
TEST_RESTORE_ADMIN_DATABASE_URL=postgres://postgres:postgres_dev@localhost:5432/paiecam_restore_test

# Secret de Better Auth (au moins 32 caractères) : openssl rand -base64 32
BETTER_AUTH_SECRET=

# Vérification des mots de passe fuités (Have I Been Pwned). « off » interdit en production.
PWNED_PASSWORDS_CHECK=on

# Trousseau de chiffrement des champs sensibles : « v1:<base64 32 octets> » (openssl rand -base64 32).
# Rotation : ajouter la nouvelle clé en tête (« v2:…,v1:… »). En prod : fourni par le KMS.
FIELD_ENCRYPTION_KEYS=

# Stockage chiffré des PDF (relatif à apps/web). En production : stockage objet S3 (phase 6).
DOCUMENTS_DIR=../../.data/documents

# En-tête posé par le proxy de l'hébergeur avec l'IP du client (obligatoire en production).
# Exemples : x-forwarded-for (avec TRUSTED_PROXY_HOPS = nombre de proxys), x-real-ip, cf-connecting-ip.
TRUSTED_PROXY_HEADER=
TRUSTED_PROXY_HOPS=1

# --- Production (obligatoires quand NODE_ENV=production) ---
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.fournisseur.example:465
# MAIL_FROM=PaieCam <noreply@votre-domaine.example>
# SECURITY_CONTACT=mailto:securite@votre-domaine.example
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.fournisseur.example
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
